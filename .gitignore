.reference/
.idea/
.vscode/
.gitignore

# Locally-created pi sessions (from running the `pi` binary against this repo)
.pi/

# Release/publish run logs (stdouts captured during `task publish` etc.)
*-publish.log
task-*.log
release-*.log
.claude/*
target/*

# Benchmark scratch: the npm-installed native pi that scripts/bench-vs-pi.mjs
# compares against (~400 MiB of node_modules).
.bench/

# Static frontend deployment bundle
.deploy/
.codegraph
.icers/*
!.icers/skills/
.icers/skills/*
!.icers/skills/ice-extension-authoring/
!.icers/skills/ice-extension-authoring/SKILL.md
!.icers/skills/ice-release/
!.icers/skills/ice-release/SKILL.md
website/.icers/*
.git/ice-release-helper.exe
publish-*.log
